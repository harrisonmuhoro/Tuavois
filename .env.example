NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://tuavois_app:use-a-strong-database-password@localhost:3306/tuavois"
# Isolated MySQL database used by the server integration test suite.
DATABASE_URL_TEST="mysql://tuavois_test:use-a-strong-test-password@localhost:3306/tuavois_test"
# Production: set a random value of at least 32 characters. Never use a development secret.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="15m"
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
# Keep false in production unless a separately reviewed public onboarding flow is enabled.
ALLOW_PUBLIC_COMPANY_PROVISIONING="false"
# Optional one-time Super Admin bootstrap values used only by the seed command.
# SUPERADMIN_NAME="Platform Administrator"
# SUPERADMIN_EMAIL="superadmin@example.com"
# SUPERADMIN_PASSWORD="use-a-temporary-secret-and-change-it-on-first-login"
